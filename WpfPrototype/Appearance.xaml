<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- EDITÁ ESTOS VALORES. Medidas WPF: equivalen a píxeles con escala de Windows al 100 %.
       Guardá y ejecutá con F5. Los controles pueden sobrescribir cada propiedad localmente. -->
  <!-- Altura común de botones, campos de una línea y desplegables cerrados. -->
  <sys:Double x:Key="ControlHeight">34</sys:Double>
  <!-- Controles dentro de las tablas: deben caber dentro de TableRowHeight. -->
  <sys:Double x:Key="TableControlHeight">23</sys:Double>
  <sys:Double x:Key="TableRowHeight">29</sys:Double>
  <sys:Double x:Key="TableHeaderHeight">38</sys:Double>
  <sys:Double x:Key="BodyFontSize">12</sys:Double>
  <FontFamily x:Key="BodyFontFamily">Segoe UI</FontFamily>
  <!-- Thickness: izquierda, arriba, derecha, abajo. Un solo número aplica a los cuatro lados. -->
  <Thickness x:Key="ButtonPadding">12,5,12,5</Thickness>
  <Thickness x:Key="InputPadding">9,4,9,4</Thickness>
  <Thickness x:Key="ControlMargin">3,2,3,2</Thickness>
  <Thickness x:Key="SourcePathMargin">0,8,0,14</Thickness>
  <!-- Paleta general. Los colores especiales de avisos y estados se conservan por separado. -->
  <SolidColorBrush x:Key="ButtonBackground" Color="#254052" />
  <SolidColorBrush x:Key="ButtonForeground" Color="#F1FAFE" />
  <SolidColorBrush x:Key="ControlBorder" Color="#39586B" />
  <SolidColorBrush x:Key="InputBackground" Color="#1B3042" />
  <SolidColorBrush x:Key="InputForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Bg" Color="#0A1421" />
    <SolidColorBrush x:Key="Panel" Color="#162538" />
    <SolidColorBrush x:Key="Inset" Color="#101D2D" />
    <SolidColorBrush x:Key="Accent" Color="#00E5FF" />
    <SolidColorBrush x:Key="Muted" Color="#A5BCCE" />
    <Style x:Key="OriginToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Background" Value="#101D2D" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="White" />
                <Setter TargetName="Surface" Property="Background" Value="#155465" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
      <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#6AF3FF" />
                <Setter Property="Foreground" Value="#061923" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#00AFC9" />
                <Setter Property="Foreground" Value="#061923" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.44" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DangerSurface" Background="#922D3B" BorderBrush="#E85B6A" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DangerSurface" Property="Background" Value="#B63848" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DangerSurface" Property="Background" Value="#70202C" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="DangerSurface" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#071B23" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="Auto" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="17,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="1,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="Background" Value="{DynamicResource InputBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
      <Setter Property="CaretBrush" Value="{DynamicResource InputForeground}" />
      <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="AcceptsReturn" Value="True">
          <Setter Property="Height" Value="Auto" />
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="Foreground" Value="#E5F0F6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,3" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="Background" Value="#101E2D" />
      <Setter Property="Foreground" Value="#EAF4F9" />
      <Setter Property="RowBackground" Value="#101E2D" />
      <Setter Property="AlternatingRowBackground" Value="#1C3043" />
      <Setter Property="BorderBrush" Value="#345064" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="HorizontalGridLinesBrush" Value="#274054" />
      <Setter Property="VerticalGridLinesBrush" Value="#274054" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="{DynamicResource TableRowHeight}" />
      <Setter Property="ColumnHeaderHeight" Value="{DynamicResource TableHeaderHeight}" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#294157" />
      <Setter Property="Foreground" Value="#F2F9FD" />
      <Setter Property="BorderBrush" Value="#36566B" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <DockPanel>
                  <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="9" Height="6" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{StaticResource Accent}" Data="M 0 6 L 4.5 0 L 9 6 Z" Stretch="Fill" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" />
                  <ContentPresenter ContentSource="Content" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" />
                </DockPanel>
              </Border>
              <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="5" Cursor="SizeWE">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
              <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="5" Cursor="SizeWE">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                <Setter TargetName="SortArrow" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#EDF6FA" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="#EAF4F9" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#176477" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="#274052" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  
</ResourceDictionary>
