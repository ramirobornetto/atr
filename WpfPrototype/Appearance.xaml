<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- EDITÁ ESTOS VALORES. Medidas WPF: equivalen a píxeles con escala de Windows al 100 %.
       Guardá y ejecutá con F5. Los controles pueden sobrescribir cada propiedad localmente. -->
  <!-- Altura común de botones, campos de una línea y desplegables cerrados. -->
  <sys:Double x:Key="ControlHeight">34</sys:Double>
  <!-- Selectores de origen e historial en Plan: más bajos que los botones. -->
  <sys:Double x:Key="PlanDropdownHeight">28</sys:Double>
  <!-- Campos numéricos de tiempos del Plan. -->
  <sys:Double x:Key="PlanNumberHeight">24</sys:Double>
  <!-- Búsqueda en Biblioteca: un poco más baja que los controles normales. -->
  <sys:Double x:Key="LibrarySearchHeight">30</sys:Double>
  <!-- Controles dentro de las tablas: deben caber dentro de TableRowHeight. -->
  <sys:Double x:Key="TableControlHeight">23</sys:Double>
  <sys:Double x:Key="TableRowHeight">29</sys:Double>
  <sys:Double x:Key="TableHeaderHeight">38</sys:Double>
  <sys:Double x:Key="BodyFontSize">12</sys:Double>
  <FontFamily x:Key="BodyFontFamily">Segoe UI</FontFamily>
  <!-- Thickness: izquierda, arriba, derecha, abajo. Un solo número aplica a los cuatro lados. -->
  <Thickness x:Key="ButtonPadding">12,5,12,5</Thickness>
  <Thickness x:Key="InputPadding">9,4,9,4</Thickness>
  <Thickness x:Key="ControlMargin">3,2,3,2</Thickness>
  <Thickness x:Key="SourcePathMargin">0,8,0,14</Thickness>
  <!-- Oscurecimiento del fondo (primer par hexadecimal = opacidad). -->
  <SolidColorBrush x:Key="BackgroundShade" Color="#78000000" />
  <!-- Paleta general. Los colores especiales de avisos y estados se conservan por separado. -->
  <SolidColorBrush x:Key="ButtonBackground" Color="#9E252B2E" />
  <SolidColorBrush x:Key="ButtonForeground" Color="#F1FAFE" />
  <SolidColorBrush x:Key="ControlBorder" Color="#665D6368" />
  <SolidColorBrush x:Key="InputBackground" Color="#B0141414" />
  <SolidColorBrush x:Key="InputForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Bg" Color="#0A1421" />
    <SolidColorBrush x:Key="Panel" Color="#BD080808" />
    <SolidColorBrush x:Key="Inset" Color="#A6040404" />
    <SolidColorBrush x:Key="Accent" Color="#00E5FF" />
    <SolidColorBrush x:Key="Muted" Color="#A5BCCE" />
<Style x:Key="OriginToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="#A0101D2D" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="White" />
              <Setter TargetName="Surface" Property="Background" Value="#A0155465" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Surface" Property="Effect"><Setter.Value><DropShadowEffect Color="#66F7F2" BlurRadius="14" ShadowDepth="0" Opacity="0.55" /></Setter.Value></Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

<Style TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
  </Style>

<Style TargetType="Button">
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
    <Setter Property="Margin" Value="{DynamicResource ControlMargin}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Glow" CornerRadius="9" Background="#64F3F2" Opacity="0" IsHitTestVisible="False">
              <Border.Effect>
                <DropShadowEffect Color="#64F3F2" BlurRadius="22" ShadowDepth="0" Opacity="0.8" />
              </Border.Effect>
            </Border>
            <Border x:Name="Face" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="Face" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#B2FFFF" Offset="0" />
                    <GradientStop Color="#58BFCD" Offset="1" />
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Setter TargetName="Face" Property="BorderBrush" Value="#B2FFFF" />
              <Setter Property="Foreground" Value="#071B24" />
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="#64F3F2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.44" />
      </Trigger>
    </Style.Triggers>
  </Style>

