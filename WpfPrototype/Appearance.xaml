<Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#071B23" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

<Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Height" Value="46" />
  <Setter Property="FontSize" Value="14" />
  <Setter Property="HorizontalContentAlignment" Value="Left" />
  <Setter Property="Margin" Value="0,4" />
  <Setter Property="Padding" Value="11,9" />
  <Setter Property="Foreground" Value="#CADAE4" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="NavFace" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
          <Border x:Name="NavOutline" CornerRadius="10" BorderBrush="#70FFFF" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
              <DropShadowEffect Color="#50FFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
            </Border.Effect>
          </Border>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="NavFace" Property="Background" Value="#393B4548" />
            <Setter Property="Foreground" Value="#B5FFFF" />
          </Trigger>
          <Trigger Property="Selector.IsSelected" Value="True">
            <Setter TargetName="NavFace" Property="Background">
              <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#553F4548" Offset="0" />
                  <GradientStop Color="#8823292C" Offset="1" />
                </LinearGradientBrush>
              </Setter.Value>
            </Setter>
            <Setter TargetName="NavFace" Property="BorderBrush" Value="Transparent" />
            <Setter TargetName="NavOutline" Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="#80FFFF" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="NavFace" Property="BorderBrush" Value="#70CED5" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>

