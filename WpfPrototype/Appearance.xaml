<Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#F0F8FC" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemFace" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemFace" Property="Background" Value="#5533C7D1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemFace" Property="Background" Value="#553C8292" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
